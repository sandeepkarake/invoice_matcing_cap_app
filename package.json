{
  "name": "invoice-matching",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/agents": "^0.9.7",
    "@cap-js/audit-logging": ">=0",
    "@cap-js/change-tracking": "^2.2.2",
    "@cap-js/mcp": "^1.5.0",
    "@sap/cds": "^10",
    "sap-s4com-supplier-v1": "file:./apis/imported/sap-s4com-supplier-v1"
  },
  "devDependencies": {
    "@cap-js/ai": "^1.2.0",
    "@cap-js/sqlite": "^3.1.1",
    "@huggingface/hub": "^2.17.5",
    "@huggingface/tokenizers": "^0.1.3",
    "@langchain/google-genai": "^2.3.2",
    "onnxruntime-node": "^1.20.1"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/matching.sqlite"
        },
        "embedding": {
          "model": "sentence-transformers/all-MiniLM-L6-v2"
        }
      }
    }
  }
}
